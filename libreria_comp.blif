
.model REGISTRO
.inputs A
.outputs O 
.latch A O re NIL 0
.end

.model SOMMATORE
.inputs A B C_IN 
.outputs O C_OUT
.names A B K 
10 1
01 1
.names K C_IN O 
10 1
01 1
.names A B C_IN C_OUT
11- 1
1-1 1
-11 1
.end

.model ZERO
.outputs O
.names O 
.end

.model UNO
.outputs O
.names O 
1
.end

.model XOR
.inputs A B
.outputs O 
.names A B O 
01 1
10 1
.end

.model DEMUX
.inputs S I
.outputs O U
.names S I O
01 1
.names S I U
11 1
.end

.model MUX
.inputs  S I0 I1 
.outputs O
.names S I0  I1 O
01- 1
1-1 1
.end 

.model OR 
