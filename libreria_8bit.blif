.subckt REGISTRO  A=A6 O=O6
.subckt REGISTRO  A=A5 O=O5
.subckt REGISTRO  A=A4 O=O4
.subckt REGISTRO  A=A3 O=O3
.subckt REGISTRO  A=A2 O=O2
.subckt REGISTRO  A=A1 O=O1
.subckt REGISTRO  A=A0 O=O0
.search libreria_comp.blif
.end 

.model SOMMATORE_8BIT 
.inputs A7 A6 A5 A4 A3 A2 A1 A0 B7 B6 B5 B4 B3 B2 B1 B0 C_IN
.outputs O7 O6 O5 O4 O3 O2 O1 O0 C_OUT 
.subckt SOMMATORE A=A0 B=B0 C_IN=C_IN O=O0 C_OUT=C0
.subckt SOMMATORE A=A1 B=B1 C_IN=C0 O=O1 C_OUT=C1
.subckt SOMMATORE A=A2 B=B2 C_IN=C1 O=O2 C_OUT=C2
.subckt SOMMATORE A=A3 B=B3 C_IN=C2 O=O3 C_OUT=C3
