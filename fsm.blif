.model fsm
.inputs RST START pH7 pH6 pH5 pH4 pH3 pH2 pH1 pH0 FINE_DATAPATH
.outputs FINE_OPERAZIONE ERRORE_SENSORE VALVOLA_ACIDO VALVOLA_BASICO SELECT

.start_kiss

.i 11 # dovrebbero essere 11 per il segnale di resoconto del datapath
.o 5 # forse 5 se dobbiamo implematare un selettore mux per contare i cicli di clk
.s 5
.p 52 # Number of states transitions (2^inputs_number * states_number)
.r RESET

# da rst a rst
-0--------- RESET RESET 00000
11--------- RESET RESET 00000

# casistiche errore
0111100001- RESET ERR 01000
011110001-- RESET ERR 01000
01111001--- RESET ERR 01000
0111101---- RESET ERR 01000
011111----- RESET ERR 01000
1---------- ERR RESET 00000
0---------- ERR ERR 01000

# caso acd
010000----- RESET ACD 00000
010001----- RESET ACD 00000
010010----- RESET ACD 00000
010011----- RESET ACD 00000
010100----- RESET ACD 00000
010101----- RESET ACD 00000
010110----- RESET ACD 00000
0-0000----0 ACD ACD 00011
0-0001----0 ACD ACD 00011
0-0010----0 ACD ACD 00011
0-0011----0 ACD ACD 00011
0-0100----0 ACD ACD 00011
0-0101----0 ACD ACD 00011
0-0110----0 ACD ACD 00011
1---------- ACD RESET 00000
0-0111----1 ACD END 10001
0-100000001 ACD END 10001

# caso bas
0110000001- RESET BAS 00000
011000001-- RESET BAS 00000
01100001--- RESET BAS 00000
0110001---- RESET BAS 00000
011001----- RESET BAS 00000
011010----- RESET BAS 00000
011011----- RESET BAS 00000
011100----- RESET BAS 00000
0111100000- RESET BAS 00000
0-100000010 BAS BAS 00101
0-1000001-0 BAS BAS 00101
0-100001--0 BAS BAS 00101
0-10001---0 BAS BAS 00101
0-1001----0 BAS BAS 00101
0-1010----0 BAS BAS 00101
0-1011----0 BAS BAS 00101
0-1100----0 BAS BAS 00101
0-111000000 BAS BAS 00101
1---------- BAS RESET 00000
0-0111----1 BAS END 10001
0-100000001 BAS END 10001

#caso fine
010111----1 RESET END 1000-
01100000001 RESET END 1000-
0-0111----1 END END 1000-
0-100000001 END END 1000-
1---------- END RESET 00000


.end_kiss
.end
