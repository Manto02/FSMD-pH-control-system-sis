.model datapath
.inputs SELECT VALVOLA_ACIDA VALVOLA_BASICA pH7 pH6 pH5 pH4 pH3 pH2 pH1 pH0
.outputs FINE_DATAPATH PH_FINALE7 PH_FINALE6 PH_FINALE5 PH_FINALE4 PH_FINALE3 PH_FINALE2 PH_FINALE1 PH_FINALE0 NCLK7 NCLK6 NCLK5 NCLK4 NCLK3 NCLK2 NCLK1 NCLK0

.subckt DEMUX_8BIT S=VALVOLA_ACIDA B7=pH7 B6=pH6 B5=pH5 B4=pH4 B3=pH3 B2=pH2 B1=pH1 B0=pH0 \
    O7=no_acd7 O6=no_acd6 O5=no_acd5 O4=no_acd4 O3=no_acd3 O2=no_acd2 O1=no_acd1 O0=no_acd0 U7=acd7 U6=pH6 U5=acd5 U4=acd4 U3=acd3 U2=acd2 U1=acd1 U0=acd0

#blocco acido

.subckt MUX_8BIT S=SELECT A7=acd7 A6=acd6 A5=acd5 A4=acd4 A3=acd3 A2=acd2 A1=acd1 A0=acd0 B7=c7 B6=c6 B5=c5 B4=c4 B3=c3 B2=c2 B1=c1 B0=c0 O7=a7 O6=a6 O5=a5 O4=a4 O3=a3 O2=a2 O1=a1 O0=a0

.subckt REGISTRO_8BIT A7=a7 A6=a6 A5=a5 A4=a4 A3=a3 A2=a2 A1=a1 A0=a0 O7=e7 O6=e6 O5=e5 O4=e4 O3=e3 O2=e2 O1=e1 O0=e0

.subckt SOLUZIONE_ACIDA A7=e7 A6=e6 A5=e5 A4=e4 A3=e3 A2=e2 A1=e1 A0=e0 O7=c7 O6=c6 O5=c5 O4=c4 O3=c3 O2=c2 O1=c1 O0=c0 

.subckt OTTO_8BIT O7=d7 O6=d6 O5=d5 O4=d4 O3=d3 O2=d2 O1=d1 O0=d0

.subckt MINORE_UGUALE_8BIT A7=c7 A6=c6 A5=c5 A4=c4 A3=c3 A2=c2 A1=c1 A0=c0 B7=d7 B6=d6 B5=d5 B4=d4 B3=d3 B2=d2 B1=d1 B0=d0 O=FINE_DATAPATH

.subckt DEMUX_8BIT S=FINE_DATAPATH B7=c7 B6=c6 B5=c5 B4=c4 B3=c3 B2=c2 B1=c1 B0=c0 \
    O7=c7 O6=c6 O5=c5 O4=c4 O3=c3 O2=c2 O1=c1 O0=c0 U7=PH_FINALE7 U6=PH_FINALE6 U5=PH_FINALE5 U4=PH_FINALE4 U3=PH_FINALE3 U2=PH_FINALE2 U1=PH_FINALE1 U0=PH_FINALE0

#blocco basico

.subckt DEMUX_8BIT S=VALVOLA_BASICA B7=no_acd7 B6=no_acd6 B5=no_acd5 B4=no_acd4 B3=no_acd3 B2=no_acd2 B1=no_acd1 B0=no_acd0 \
    O7=PH_FINALE7 O6=PH_FINALE6 O5=PH_FINALE5 O4=PH_FINALE4 O3=PH_FINALE3 O2=PH_FINALE2 O1=PH_FINALE1 O0=PH_FINALE0 U7=bas7 U6=bas6 U5=bas5 U4=bas4 U3=bas3 U2=bas2 U1=bas1 U0=bas0

.subckt MUX_8BIT S=SELECT A7=bas7 A6=bas6 A5=bas5 A4=bas4 A3=bas3 A2=bas2 A1=bas1 A0=bas0 B7=f7 B6=f6 B5=f5 B4=f4 B3=f3 B2=f2 B1=f1 B0=f0 O7=g7 O6=g6 O5=g5 O4=g4 O3=g3 O2=g2 O1=g1 O0=g0

.subckt REGISTRO_8BIT A7=g7 A6=g6 A5=g5 A4=g4 A3=g3 A2=g2 A1=g1 A0=g0 O7=h7 O6=h6 O5=h5 O4=h4 O3=h3 O2=h2 O1=h1 O0=h0

.subckt SOLUZIONE_BASICA A7=h7 A6=h6 A5=h5 A4=h4 A3=h3 A2=h2 A1=h1 A0=h0 O7=f7 O6=f6 O5=f5 O4=f4 O3=f3 O2=f2 O1=f1 O0=f0 

.subckt MIN7_8BIT O7=i7 O6=i6 O5=i5 O4=i4 O3=i3 O2=i2 O1=i1 O0=i0

.subckt MAGGIORE_8BIT A7=f7 A6=f6 A5=f5 A4=f4 A3=f3 A2=f2 A1=f1 A0=f0 B7=i7 B6=i6 B5=i5 B4=i4 B3=i3 B2=i2 B1=i1 B0=i0 O=FINE_DATAPATH

.subckt DEMUX_8BIT S=FINE_DATAPATH B7=f7 B6=f6 B5=f5 B4=f4 B3=f3 B2=f2 B1=f1 B0=f0 \
    O7=f7 O6=f6 O5=f5 O4=f4 O3=f3 O2=f2 O1=f1 O0=f0 U7=PH_FINALE7 U6=PH_FINALE6 U5=PH_FINALE5 U4=PH_FINALE4 U3=PH_FINALE3 U2=PH_FINALE2 U1=PH_FINALE1 U0=PH_FINALE0


#blocco contatore cicli di clk

.subckt ZERO_8BIT O7=z7 O6=z6 O5=z5 O4=z4 O3=z3 O2=z2 O1=z1 O0=z0

.subckt MUX_8BIT S=SELECT A7=z7 A6=z6 A5=z5 A4=z4 A3=z3 A2=z2 A1=z1 A0=z0 B7=pH7 B6=pH6 B5=pH5 B4=pH4 B3=pH3 B2=pH2 B1=pH1 B0=pH0 O7=j7 O6=j6 O5=j5 O4=j4 O3=j3 O2=j2 O1=j1 O0=j0

.subckt MUX_8BIT S=SELECT A7=j7 A6=j6 A5=j5 A4=j4 A3=j3 A2=j2 A1=j1 A0=j0 B7=n7 B6=n6 B5=n5 B4=n4 B3=n3 B2=n2 B1=n1 B0=n0 O7=k7 O6=k6 O5=k5 O4=k4 O3=k3 O2=k2 O1=k1 O0=k0

.subckt REGISTRO_8BIT A7=k7 A6=k6 A5=k5 A4=k4 A3=k3 A2=k2 A1=k1 A0=k0 O7=l7 O6=l6 O5=l5 O4=l4 O3=l3 O2=l2 O1=l1 O0=l0

.subckt DEMUX_8BIT S=FINE_DATAPATH B7=l7 B6=l6 B5=l5 B4=l4 B3=l3 B2=l2 B1=l1 B0=l0 \
    O7=m7 O6=m6 O5=m5 O4=m4 O3=m3 O2=m2 O1=m1 O0=m0 U7=NCLK7 U6=NCLK6 U5=NCLK5 U4=NCLK4 U3=NCLK3 U2=NCLK2 U1=NCLK1 U0=NCLK0

.subckt INCREMENTATORE_8BIT A7=m7 A6=m6 A5=m5 A4=m4 A3=m3 A2=m2 A1=m1 A0=m0  O7=n7 O6=n6 O5=n5 O4=n4 O3=n3 O2=n2 O1=n1 O0=n0

.search libreria_comp.blif
.search libreria_8bit.blif

.end
